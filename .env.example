# Copy to .env and adjust. Never commit a real .env file.

# --- Database ---------------------------------------------------------------
# Application database (PostgreSQL). Matches docker-compose.yml defaults.
DATABASE_URL=postgresql+psycopg://warranty:change_me@localhost:5432/warranty_db
# Separate database used by the automated test suite (it is wiped by tests).
TEST_DATABASE_URL=postgresql+psycopg://warranty:change_me@localhost:5432/warranty_test
POSTGRES_USER=warranty
POSTGRES_PASSWORD=change_me
POSTGRES_DB=warranty_db

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_MINUTES=480
# development | production. In production the demo users are not seeded with
# known passwords and training is restricted to administrators.
APP_ENV=development
# Password assigned to seeded demo users (development only).
DEMO_USER_PASSWORD=change_me_demo

# --- API / CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Machine learning ----------------------------------------------------------
MODEL_ARTIFACT_DIR=model_artifacts

# --- Frontend (Vite) -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Docker Compose host ports (optional) ------------------------------------------
# Override if the host already uses these ports (e.g. a local PostgreSQL on 5432).
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=8000
# WEB_HOST_PORT=8080
